# Optional — the app works without any keys (Open-Meteo needs none).
# These are read ONLY by the serverless functions in /api (never exposed to the browser).

# Free token: https://aqicn.org/data-platform/token  → enables real ground-station measurements
WAQI_TOKEN=

# Free key: https://console.groq.com/keys → enables the LLM-powered AI assistant
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Alternative to Groq
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Free key: https://data.gov.in (Sign up -> My Account -> API key) -> official CPCB station NAQI
DATAGOV_API_KEY=

# Free key: https://aistudio.google.com/apikey  (preferred LLM provider)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
