{
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(earth-night.jpg|earth-topology.jpg|og.jpg|icon.svg|manifest.webmanifest)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] }
  ]
}
